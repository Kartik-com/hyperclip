# ==============================================================
# HyperClip Environment Configuration
# ==============================================================

# AI Brain Configuration (Any OpenAI-compatible API or FreeLLMAPI)
# 1. To use your custom FreeLLMAPI aggregator:
LLM_PROVIDER=custom
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=your_key_or_dummy
LLM_MODEL=gpt-4o-mini

# 2. Or to use Google Gemini Free API:
# LLM_PROVIDER=gemini
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your_gemini_api_key
# LLM_MODEL=gemini-2.5-flash

# 3. Or to use local Ollama:
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# Speech Recognition (Local GPU)
TRANSCRIPTION_DEVICE=cuda
WHISPER_MODEL=base

# Video Layout Defaults
DEFAULT_LAYOUT=auto
MAX_CLIP_DURATION=60
MIN_CLIP_DURATION=20
